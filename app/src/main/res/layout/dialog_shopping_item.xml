<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <EditText android:id="@+id/shoppingNameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Item name" android:inputType="textCapSentences" />
    <EditText android:id="@+id/shoppingQuantityInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity (greater than 0)" android:inputType="numberDecimal" />
    <Spinner android:id="@+id/shoppingUnitInput" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
