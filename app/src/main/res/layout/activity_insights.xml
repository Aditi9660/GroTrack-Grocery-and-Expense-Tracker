<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/grotrack_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GroTrack Insights" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/grotrack_dark_green" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Summaries are calculated from your saved products, batches, and waste records." android:textColor="@color/grotrack_secondary" android:paddingBottom="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inventory overview" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/grotrack_text" android:paddingTop="8dp" />
        <TextView android:id="@+id/insightInventorySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/grotrack_light_green" android:padding="16dp" android:text="Loading inventory…" android:textColor="@color/grotrack_dark_green" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Food waste" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/grotrack_text" android:paddingTop="16dp" />
        <Spinner android:id="@+id/insightPeriodFilter" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/insightWasteRecordCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFF4D8" android:padding="14dp" android:text="Waste records: 0" android:textColor="#8A5A00" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wasted quantity by unit" android:textStyle="bold" android:textColor="@color/grotrack_text" android:paddingTop="14dp" />
        <TextView android:id="@+id/insightWasteQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="@color/grotrack_card" android:text="No waste recorded in this period." android:textColor="@color/grotrack_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Most frequently wasted products" android:textStyle="bold" android:textColor="@color/grotrack_text" android:paddingTop="14dp" />
        <TextView android:id="@+id/insightTopWasted" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="@color/grotrack_card" android:text="No waste recorded in this period." android:textColor="@color/grotrack_text" />
        <Button android:id="@+id/insightWasteHistoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open waste history" android:textAllCaps="false" />
        <Button android:id="@+id/insightBackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
