<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/grotrack_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingTop="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@string/splash_screen_description" android:src="@drawable/ic_grotrack_logo" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GroTrack" android:textColor="@color/grotrack_dark_green" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Track Smart. Waste Less." android:textColor="@color/grotrack_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Good day!" android:textColor="@color/grotrack_text" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A little planning helps every grocery go further." android:textColor="@color/grotrack_secondary" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_marginEnd="5dp" android:layout_weight="1" app:cardBackgroundColor="@color/grotrack_light_green" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/homeProductCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/grotrack_dark_green" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Products" android:textColor="@color/grotrack_text" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_marginHorizontal="5dp" android:layout_weight="1" app:cardBackgroundColor="#FFF4D8" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/homeExpiringCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#8A5A00" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expiring soon" android:textColor="@color/grotrack_text" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_marginStart="5dp" android:layout_weight="1" app:cardBackgroundColor="#FCE8E6" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/homeLowStockCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/grotrack_expired" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Low stock" android:textColor="@color/grotrack_text" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Your groceries" android:textColor="@color/grotrack_text" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/homeInventoryDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@color/grotrack_card" android:padding="14dp" android:text="Loading inventory summary…" android:textColor="@color/grotrack_secondary" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Quick access" android:textColor="@color/grotrack_text" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/navInventoryCard" android:layout_width="0dp" android:layout_height="84dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/grotrack_card" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Inventory" android:src="@drawable/ic_inventory" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Inventory" android:textColor="@color/grotrack_dark_green" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/navShoppingCard" android:layout_width="0dp" android:layout_height="84dp" android:layout_marginStart="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/grotrack_card" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Shopping basket" android:src="@drawable/ic_shopping" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shopping List" android:textColor="@color/grotrack_dark_green" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/navWasteCard" android:layout_width="0dp" android:layout_height="84dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/grotrack_card" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Waste history" android:src="@drawable/ic_history" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Waste History" android:textColor="@color/grotrack_dark_green" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/navInsightsCard" android:layout_width="0dp" android:layout_height="84dp" android:layout_marginStart="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/grotrack_card" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Insights" android:src="@drawable/ic_insights" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Insights" android:textColor="@color/grotrack_dark_green" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Expiring soon" android:textColor="@color/grotrack_text" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/homeExpiringList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
        <TextView android:id="@+id/homeWasteSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@color/grotrack_light_green" android:padding="14dp" android:text="Waste summary is loading…" android:textColor="@color/grotrack_dark_green" android:textSize="14sp" />
        <Button android:id="@+id/homeAddItemButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="+  Add grocery item" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/homeEnableNotificationsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enable expiry alerts" android:textSize="12sp" />
            <Button android:id="@+id/homeTestExpiryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Test alert" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="10dp" android:text="Expiry alerts run daily in the background" android:textColor="@color/grotrack_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
