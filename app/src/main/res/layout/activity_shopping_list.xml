<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/grotrack_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shopping List" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/grotrack_dark_green" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Items enter your inventory only after you record the purchase." android:textColor="@color/grotrack_secondary" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/suggestLowStockButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Suggest low stock" android:textAllCaps="false" />
        <Button android:id="@+id/addShoppingItemButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add item" android:textAllCaps="false" />
    </LinearLayout>
    <Button android:id="@+id/backToInventoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back" android:textAllCaps="false" />
    <Button android:id="@+id/openShoppingWasteHistoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View waste history" android:textAllCaps="false" />
    <TextView android:id="@+id/shoppingEmptyMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Your shopping list is empty." android:textColor="#68756B" android:padding="20dp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/shoppingList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
</LinearLayout>
