<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/grotrack_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/shoppingItemName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item" android:textSize="18sp" android:textStyle="bold" android:textColor="#24372B" />
        <TextView android:id="@+id/shoppingItemMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#59665D" android:paddingTop="3dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal">
            <Button android:id="@+id/shoppingPurchaseButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:text="Record purchase" android:textAllCaps="false" />
            <Button android:id="@+id/shoppingEditButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:text="Edit" android:textAllCaps="false" />
            <Button android:id="@+id/shoppingDeleteButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="44dp" android:text="Remove" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
